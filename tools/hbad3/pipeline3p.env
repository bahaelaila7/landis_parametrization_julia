# HBAD3P pipeline configuration — the ONE place for every switch and input path (sourced by tools/hbad3/pipeline3p.sh; docs/hbad3p_pipeline.md).
# Paths are relative to the workspace root (the parent folder of this repo) unless set in the environment beforehand.
_repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export WORKSPACE="${WORKSPACE:-$(dirname "$_repo")}"
# ---- external inputs (all read-only)
export HBAD3_SLIM_DB="${HBAD3_SLIM_DB:-$WORKSPACE/landis_region4/data_r4/slim_r4.duckdb}"            # curated trees / cohorts, REF_SPECIES (R4 states)
export HBAD3_FIADB="${HBAD3_FIADB:-$WORKSPACE/FIA/FIASQLITE2PGSQL/FIADB.duckdb}"                      # SUBP_COND / COND / PLOT (forested area of subplots)
export HBAD3_PRISM_DB="${HBAD3_PRISM_DB:-$WORKSPACE/PRISM_LT/PRISM_LT_EPA/prism_lt_epa.duckdb}"       # PRISM L4 monthly (°C / mm / hPa)
export HBAD3_SOIL_CSV="${HBAD3_SOIL_CSV:-$WORKSPACE/landis_region4/data_r4/plot_soil_r4.csv}"         # plot AWC (SOLUS + Saxton–Rawls)
export HBAD3_SHADETOL_CSV="${HBAD3_SHADETOL_CSV:-$WORKSPACE/landis_region4/data_r4/shadetol_all_species.csv}"   # shade class 1–5 per species (FIA CCLCD)
export HBAD3_LONGEVITY_CSV="${HBAD3_LONGEVITY_CSV:-$WORKSPACE/species_longevity_ref.csv}"             # LONGEVITY per species
export HBAD3_PAN_R4="${HBAD3_PAN_R4:-$WORKSPACE/landis_hbad2_r4}"                                     # Pan (branch hbad2-r4): builder + cache of the interval product
export HBAD3_PYTHON="${HBAD3_PYTHON:-$WORKSPACE/standmap/.venv/bin/python}"                           # python with numpy pandas pyarrow duckdb scipy
# ---- derived data products (this repo; R4-wide, region-independent)
export HBAD2_DATA_DIR=results/hbad2_r4                                    # intervals.arrow, interval_trees.arrow, interval_ingrowth.arrow
export HBAD3_CLIM_CSV=results/hbad3/interval_climate_r4.csv
export HBAD3_WATER_CSV=results/hbad3/interval_water_r4.csv
export HBAD3_FOREST_CSV=results/hbad3/subplot_forest_r4.csv
# ---- model structure (recorded in each fit's meta.txt and checked by every later stage)
export HBAD2_FORM=2 HBAD2_SIZE_SPLIT=5,12.7,25,40 HBAD2_SITE=subplot HBAD2_VIGOUR=1 HBAD2_SIGV_MAX=1.2 HBAD2_VIG_N=5
export HBAD3P_FAREA="${HBAD3P_FAREA:-1}"                                  # stand densities per ha of the forested subplot
# ---- Sim A fit (CMA-ES)
export HBAD2_EVALS="${HBAD2_EVALS:-6000}" HBAD2_SIGMA="${HBAD2_SIGMA:-0.15}" HBAD2_LAMBDA="${HBAD2_LAMBDA:-24}"
# HBAD3P_FIX (e.g. "gR:0.0"), HBAD3P_START (a fit3p dir to warm-start from), HBAD3P_COUPLED: optional, pass through the environment
# CMA-ES step: 0.15 suits a cold start; a WARM start (HBAD3P_START) needs ~0.01. The objective curves ~3.5 nats per 0.01 in single coordinates, so
# sigma 0.06 over 42 coordinates makes every candidate worse, and CMA spends most of the budget shrinking sigma (P3_GAFL 2026-10-21: no gain in 1,800 evals).
export THREADS="${THREADS:-4}"

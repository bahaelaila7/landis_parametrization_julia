Natural            1    Parms(SU, ST1MRA, 100, REGENAGE, 0, 0)
End
Compute            1
RegTotal = Regtotal + ST1MRA
End
EndIf

** tuliptree
IF        10
SpMcDBH(11,ALL,0,1.0,999,1.0,999,0) LE BSDIMAX*0.75 AND SpMcDBH(1,YP,0,5,999,10,999,0) GT 0.001 AND REGTRIG EQ 1
Then
Estab
Natural            1    Parms(YP, ST2MRA, 100, REGENAGE, 0, 0)
End
Compute            1
RegTotal = Regtotal + ST2MRA
End
EndIf

